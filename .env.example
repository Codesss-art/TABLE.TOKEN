# TableToken Environment Variables Template
# Copy this file to .env and adjust the settings as needed

PORT=3000
NODE_ENV=production
SESSION_SECRET=your-random-32-character-session-secret-here

# Database path (use a persistent volume mount path in production like /data/tabletoken.db)
DB_PATH=./tabletoken.db

# Base URL used for generating table QR codes (e.g. https://tabletoken.onrender.com or http://192.168.1.50:3000)
BASE_URL=http://localhost:3000
